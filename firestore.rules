rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allowlist: readable by any authenticated user (for login gate check)
    match /allowlist/{email} {
      allow read: if request.auth != null;
      allow write: if false; // admin only via console
    }

    // NDA compliance: each user can only read/write their own record
    match /ndaCompliance/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Game data: each user owns their own document
    match /users_game_data/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Per-day activity counters (logins, missions, questions, summons,
      // boss fights) that the twice-daily Sheets export reads via the
      // Admin SDK. Same trust boundary as the parent doc: the client is
      // already authoritative for its own game state.
      match /dailyStats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public profile directory: minimal {uid, name, photoUrl} doc so a user
    // can be looked up by Academy ID (uid) when sending a friend request.
    // Readable by any signed-in user; only the owner can write their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend requests: sender creates it; both sides can read/update it
    // (recipient accepts/rejects, sender acknowledges an accepted request
    // when reconciling their own friends list). Either side may delete
    // (cancel a pending request / clear a resolved one).
    match /friendRequests/{requestId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // Friends list: each user owns their own list of friend uids.
    match /friends/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin daily-stats dashboard (public/admin.html): lets the app owner
    // read dailyStats across every user via a collection-group query,
    // without opening it up to other signed-in users. Write access to
    // these docs is untouched — still owner-only, per the nested rule
    // above under users_game_data/{uid}.
    match /{path=**}/dailyStats/{date} {
      allow read: if request.auth != null && request.auth.token.email == 'maxidea2008@gmail.com';
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
